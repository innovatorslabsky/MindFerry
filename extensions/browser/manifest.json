{
  "manifest_version": 3,
  "name": "MindFerry Library",
  "version": "0.1.0",
  "description": "Save the page you are reading to your MindFerry library.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Save to MindFerry",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": { "id": "library@mindferry.invalid", "strict_min_version": "128.0" }
  }
}
